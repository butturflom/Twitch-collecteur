# Twitch Overlap — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs

# ============================================
# Configuration du Collecteur (backend)
# ============================================

# Clés API Twitch (obtenir sur dev.twitch.tv/console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Chaîne à surveiller (nom sans le préfixe @ ou ttv)
TWITCH_CHANNEL=

# Clés Supabase (Project Settings > API)
SUPABASE_URL=https:// votre-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# Configuration de l'Application Partagée
# ============================================

# Client ID pour l'application (lecture seule)
VITE_TWITCH_CLIENT_ID=

# URL et clé Supabase pour le frontend
VITE_SUPABASE_URL=https:// votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=

# ============================================
# Options Générales
# ============================================

# Niveau de logs : debug, info, warn, error
LOG_LEVEL=info

# Mode environnement
NODE_ENV=production